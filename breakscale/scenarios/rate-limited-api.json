    },
    {
      "name": "quotaRps",
      "value": null,
      "unit": "requests/second",
      "provenance": "TBD",
      "source": "product policy / gateway telemetry"
    },
    {
      "name": "burst",
      "value": null,
      "unit": "requests",
      "provenance": "TBD",
      "source": "product policy"
    },
    {
      "name": "offeredRpsSweep",
      "values": [
        50,
